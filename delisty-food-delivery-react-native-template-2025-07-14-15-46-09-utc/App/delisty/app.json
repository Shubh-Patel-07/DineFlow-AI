{
    "expo": {
        "name": "DineFlow AI",
        "slug": "dineflow-ai",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "userInterfaceStyle": "light",
        "plugins": [
            [
                "expo-splash-screen",
                {
                    "image": "./assets/splash.png",
                    "resizeMode": "cover",
                    "backgroundColor": "#000000"
                }
            ]
        ],
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#FFFFFF"
            }
        },
        "web": {
            "favicon": "./assets/favicon.png"
        }
    }
}

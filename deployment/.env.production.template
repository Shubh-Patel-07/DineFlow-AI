# ==============================================================================
# TENDORABUY / DINEFLOW AI — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to /var/www/tendorabuy/.env on your production VPS
# NEVER commit the final .env file with real passwords to Git!
# ==============================================================================

APP_NAME="Tendorabuy POS"
APP_ENV=production
APP_KEY=base64:GENERATE_VIA_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://tendorabuy.in
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

# Security & Sessions
BCRYPT_ROUNDS=12
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Logging (Rotated Daily)
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# Production MySQL Database Connection
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dineflow_ai
DB_USERNAME=root
DB_PASSWORD=

# Drivers
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Production SMTP Email Server (Gmail App Pass / SendGrid / Brevo)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="support@tendorabuy.in"
MAIL_FROM_NAME="Tendorabuy Support"

# Super Admin Seed Credentials
SUPERADMIN_EMAIL=superadmin@tendorabuy.in
SUPERADMIN_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
SUPERADMIN_NAME="Tendorabuy Super Admin"
SUPERADMIN_USERNAME=superadmin

# Soundbox & Hardware Defaults
SOUNDBOX_DEFAULT_LANG=gu
PRINTER_DEFAULT_TYPE=SYSTEM_DEFAULT
